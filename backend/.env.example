# NVIDIA NIM (agent orchestration) — https://build.nvidia.com/
# meta/llama-3.1-70b-instruct is broadly available and handles tool-calling
# well. moonshotai/kimi-k2.6 is stronger but needs separate access approval
# per-account on build.nvidia.com even though it's catalog-listed — request
# access there, then switch this value once approved.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Used if NVIDIA_MODEL's call fails (rate limit, timeout, not-yet-approved access, etc).
# Should be a model you know is available on your account — meta/llama-3.1-70b-instruct
# needs no separate approval, which is why it's the default fallback.
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-70b-instruct

# Database
DATABASE_URL=postgresql+asyncpg://delivery_health:delivery_health@localhost:5432/delivery_health

# Set to false once you wire up real credentials below for a given source.
# Sources without credentials always fall back to mock data regardless of this flag.
USE_MOCK_DATA=true

# GitHub (code activity + CI/CD via GitHub Actions)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Jira (sprint progress). JIRA_API_TOKEN must be a *scoped* API token (id.atlassian.com ->
# "Create API token with scopes" -> app "Rovo MCP V2", all scopes checked) — a classic/legacy
# token will not work. Your org admin also has to enable API token auth once, at
# admin.atlassian.com -> Rovo -> Rovo MCP server -> Authentication. See backend/docs/jira-setup.md
# for the full walkthrough (there's a fair bit of one-time Atlassian-side setup).
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173

# Requests/minute allowed per client IP on POST /api/chat. 0 or negative disables the limit.
CHAT_RATE_LIMIT_PER_MINUTE=20
